{
  "compilerOptions": {
    "target": "ES6",                    
    "module": "ESNext",                
    "outDir": "./dist/js",                  
    "rootDir": "./src/ts",                
    "strict": true,                      
    "esModuleInterop": true,            
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,                
    "moduleResolution": "bundler",          
    "allowJs": false,                    
  },
  "include": [
    "src/ts/main.ts",
    "src/ts/home.ts",
    "src/ts/about.ts",
    "src/ts/cart.ts",
    "src/ts/catalog.ts",
    "src/ts/contact.ts",
    "src/ts/product.ts",
    "src/ts/cart-utils.ts"
   
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
